{
  "name": "farmacia",
  "private": true,
  "scripts": {
    "dev": "concurrently -n API,WEB,OPEN -c blue,magenta,green \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:open\"",
    "dev:api": "python run_api_only.py",
    "dev:web": "cd farmacia-app && npm run web",
    "dev:open": "wait-on http://localhost:8081 && node scripts/open-web.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "wait-on": "^8.0.1"
  }
}
