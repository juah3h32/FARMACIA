# pip crea un archivo literal "=X.Y.Z" cuando `pip install paquete >= 1.0.0` se
# ejecuta sin comillas en PowerShell (el shell separa ">=" y lo interpreta como
# redirección) — ya ha pasado más de una vez, de ahí el patrón genérico.
=*.*.*

